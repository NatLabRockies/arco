class Sense(Enum):
    MINIMIZE: Sense
    MAXIMIZE: Sense

class SimplifyLevel(Enum):
    NONE: SimplifyLevel
    LIGHT: SimplifyLevel

class SolutionStatus(Enum):
    OPTIMAL: SolutionStatus
    INFEASIBLE: SolutionStatus
    UNBOUNDED: SolutionStatus
    TIME_LIMIT: SolutionStatus
    ERROR: SolutionStatus

class BoundType(Enum):
    PositiveFloat: BoundType
    NegativeFloat: BoundType
    NonNegativeFloat: BoundType
    NonPositiveFloat: BoundType
    PositiveInt: BoundType
    NegativeInt: BoundType
    NonNegativeInt: BoundType
    NonPositiveInt: BoundType
    Binary: BoundType

PositiveFloat: BoundType
NegativeFloat: BoundType
NonNegativeFloat: BoundType
NonPositiveFloat: BoundType
PositiveInt: BoundType
NegativeInt: BoundType
NonNegativeInt: BoundType
NonPositiveInt: BoundType
Binary: BoundType

class Bounds:
    def __init__(
        self,
        lo: BoundValue | None = None,
        hi: BoundValue | None = None,
        *,
        lower: BoundValue | None = None,
        upper: BoundValue | None = None,
    ) -> None: ...
    @property
    def lower(self) -> BoundValue: ...
    @property
    def upper(self) -> BoundValue: ...

class Solver:
    def __init__(
        self,
        *,
        presolve: bool | None = None,
        threads: int | None = None,
        tolerance: float | None = None,
        time_limit: float | None = None,
        mip_gap: float | None = None,
        verbosity: int | None = None,
        log_to_console: bool | None = None,
    ) -> None: ...
    @property
    def presolve(self) -> bool | None: ...
    @property
    def threads(self) -> int | None: ...
    @property
    def tolerance(self) -> float | None: ...
    @property
    def time_limit(self) -> float | None: ...
    @property
    def mip_gap(self) -> float | None: ...
    @property
    def verbosity(self) -> int | None: ...
    @property
    def log_to_console(self) -> bool | None: ...
    def copy(
        self, *, update: Mapping[str, bool | int | float | None] | None = None
    ) -> Solver: ...

class HiGHS(Solver): ...
class Xpress(Solver): ...

class IndexSet:
    def __init__(
        self,
        name: str,
        *,
        size: int | None = None,
        members: Sequence[IndexMember] | None = None,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def size(self) -> int: ...
    @property
    def members(self) -> list[IndexMember]: ...

class Expr:
    def __init__(self) -> None: ...
    def scale(self, *, by: float) -> Expr: ...
    def add(self, *, other: Expr) -> Expr: ...
    def __add__(self, other: Expr | Variable | float) -> Expr: ...
    def __radd__(self, other: Expr | Variable | float) -> Expr: ...
    def __sub__(self, other: Expr | Variable | float) -> Expr: ...
    def __rsub__(self, other: Expr | Variable | float) -> Expr: ...
    def __mul__(self, other: float) -> Expr: ...
    def __rmul__(self, other: float) -> Expr: ...
    def __neg__(self) -> Expr: ...
    def __truediv__(self, other: float) -> Expr: ...
    def __ge__(self, rhs: Expr | Variable | float) -> ConstraintExpr: ...
    def __le__(self, rhs: Expr | Variable | float) -> ConstraintExpr: ...
    def __eq__(self, rhs: object) -> ConstraintExpr: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class ConstraintExpr:
    @property
    def expr(self) -> Expr: ...
    @property
    def sense(self) -> str: ...
    @property
    def rhs(self) -> float: ...

class Variable:
    @property
    def name(self) -> str | None: ...
    @property
    def bounds(self) -> Bounds: ...
    @property
    def is_integer(self) -> bool: ...
    @property
    def is_binary(self) -> bool: ...
    def __add__(self, other: Expr | Variable | float) -> Expr: ...
    def __radd__(self, other: Expr | Variable | float) -> Expr: ...
    def __sub__(self, other: Expr | Variable | float) -> Expr: ...
    def __rsub__(self, other: Expr | Variable | float) -> Expr: ...
    def __mul__(self, other: float) -> Expr: ...
    def __rmul__(self, other: float) -> Expr: ...
    def __neg__(self) -> Expr: ...
    def __truediv__(self, other: float) -> Expr: ...
    def __ge__(self, rhs: Expr | Variable | float) -> ConstraintExpr: ...
    def __le__(self, rhs: Expr | Variable | float) -> ConstraintExpr: ...
    def __eq__(self, rhs: object) -> ConstraintExpr: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class Constraint:
    @property
    def name(self) -> str | None: ...
    @property
    def bounds(self) -> Bounds: ...

class VariableArray:
    def __add__(
        self, other: VariableArray | ExprArray | float | Sequence[float]
    ) -> ExprArray: ...
    def __radd__(
        self, other: VariableArray | ExprArray | float | Sequence[float]
    ) -> ExprArray: ...
    def __sub__(
        self, other: VariableArray | ExprArray | float | Sequence[float]
    ) -> ExprArray: ...
    def __rsub__(
        self, other: VariableArray | ExprArray | float | Sequence[float]
    ) -> ExprArray: ...
    def __mul__(self, other: float | Sequence[float]) -> ExprArray: ...
    def __rmul__(self, other: float | Sequence[float]) -> ExprArray: ...
    def __truediv__(self, other: float) -> ExprArray: ...
    def __neg__(self) -> ExprArray: ...
    def __ge__(
        self,
        rhs: VariableArray | ExprArray | float | Sequence[float] | IndexSet,
    ) -> ConstraintArray: ...
    def __le__(
        self,
        rhs: VariableArray | ExprArray | float | Sequence[float] | IndexSet,
    ) -> ConstraintArray: ...
    def __eq__(
        self,
        rhs: VariableArray | ExprArray | float | Sequence[float] | IndexSet,
    ) -> ConstraintArray: ...
    @property
    def variables(self) -> list[Variable]: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def index_sets(self) -> tuple[IndexSet, ...]: ...
    @property
    def values(self) -> list[Expr]: ...
    def flatten(self) -> list[Expr]: ...
    def __len__(self) -> int: ...
    def __getitem__(
        self, index: int | slice | tuple[object, object] | object
    ) -> Variable | VariableArray: ...
    def sum(
        self, *, over: IndexSet | Sequence[IndexSet] | None = None
    ) -> Expr | ExprArray: ...

class ExprArray:
