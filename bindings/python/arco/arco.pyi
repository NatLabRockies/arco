    def __truediv__(self, other: float) -> ExprArray: ...
    def __neg__(self) -> ExprArray: ...
    def __ge__(
        self,
        rhs: VariableArray | ExprArray | float | Sequence[float] | IndexSet,
    ) -> ConstraintArray: ...
    def __le__(
        self,
        rhs: VariableArray | ExprArray | float | Sequence[float] | IndexSet,
    ) -> ConstraintArray: ...
    def __eq__(
