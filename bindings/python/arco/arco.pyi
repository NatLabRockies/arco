from __future__ import annotations

from enum import Enum
from typing import Callable, Mapping, Sequence, TypeAlias, TypedDict, TypeVar

BlockFnT = TypeVar("BlockFnT", bound=Callable[..., object])

IndexMember: TypeAlias = int | float | str
JsonPrimitive: TypeAlias = None | bool | int | float | str
JsonValue: TypeAlias = JsonPrimitive | list["JsonValue"] | dict[str, "JsonValue"]
BoundValue: TypeAlias = float | Sequence[float] | Sequence[Sequence[float]]

class SolverInfo(TypedDict):
    solver: str
    version: str | None

class CscExport(TypedDict):
    col_ptrs: Sequence[int]
    row_indices: Sequence[int]
    values: Sequence[float]
    shape: tuple[int, int]

class CrsExport(TypedDict):
    row_ptrs: Sequence[int]
    col_indices: Sequence[int]
    values: Sequence[float]
    shape: tuple[int, int]

class CooExport(TypedDict):
    rows: Sequence[int]
    cols: Sequence[int]
    values: Sequence[float]
    shape: tuple[int, int]

