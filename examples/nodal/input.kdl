// Phase 1A: Nodal Allocation Optimization (Step 1) - Canonical Form
// Goal: Allocate capacity to meet total system demand at minimum cost.
// Key: 'g' for generator, 'n' for node, 't' for time

model "NodalAllocation" {

    // ===================================================================
    // Investment variables (generator + node, two indices)
    // ===================================================================
    control "capacity_mw" lower=0 {
        g in="generators"
        n in="nodes"
    }

    // ===================================================================
    // Dispatch variables (generator + node + time, three indices)
    // ===================================================================
    control "dispatch_mw" lower=0 {
        g in="generators"
        n in="nodes"
        t in="time"
    }

    // ===================================================================
    // Capacity constraints
    // ===================================================================
    constraint "max_capacity" {
        over "g" in="generators"
        expr {
            sum(capacity_mw[g,n] for n in nodes) <= capacity[g]
        }
    }

    // ===================================================================
    // Dispatch constraints
    // ===================================================================
    constraint "generation_limit" {
        over "g" in="generators"
        over "n" in="nodes"
        over "t" in="time"
        expr {
            dispatch_mw[g,n,t] <= capacity_mw[g,n] * capacity_factor[g,t]
        }
    }

    // ===================================================================
    // Nodal balance constraint
    // ===================================================================
    constraint "meet_nodal_demand" {
        over "n" in="nodes"
        over "t" in="time"
        expr {
            sum(dispatch_mw[g,n,t] for g in generators if pair_exists[g,n])
            = MWLoad[n]
        }
    }

    // ===================================================================
    // Objective: Total Investment Cost
    // ===================================================================
    minimize "TotalCost" {
        sum(
            (distance_km[g,n] * cost_spur_usd_per_km_mw[g]
             + cost_poi_usd_per_mw[g]
             + cost_reinforcement_usd_per_mw[g])
            * capacity_mw[g,n]
            for g in generators for n in nodes if pair_exists[g,n])
    }
}

// ---------------------------------------------------------------------------
// Scenario: wire the model to data
// ---------------------------------------------------------------------------

scenario "Phase1A_Run" {
    horizon steps=1 resolution="PT1H"
    use "NodalAllocation"

    // Time set
    time { "1" }

    // Load sets from CSV
    set "nodes" from="data/node_sites 2.csv"
    set "generators" from="data/SC_gen_sites 2.csv"

    // Data declarations from CSVs
    data "MWLoad" from="data/node_sites 2.csv"
    data "capacity" from="data/SC_gen_sites 2.csv"
    data "capacity_factor" from="data/SC_gen_sites 2.csv"
    data "cost_spur_usd_per_km_mw" from="data/SC_gen_sites 2.csv"
    data "cost_poi_usd_per_mw" from="data/SC_gen_sites 2.csv"
    data "cost_reinforcement_usd_per_mw" from="data/SC_gen_sites 2.csv"
    data "distance_km" from="data/gen_to_node_distance 1.csv"
    data "pair_exists" from="data/gen_to_node_distance 1.csv"
}
