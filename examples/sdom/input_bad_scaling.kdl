// Storage Deployment Optimization Model (SDOM) - bad-scaling dataset variant
// Uses examples/bad-scaling/data/* inputs with the legacy SDOM-style layout.
// Adds missing formulation pieces from docs/reference/formulations/sdom.md:
// - imports/exports with net-load gating and trade costs
// - thermal min/max capacity bounds
// - clean-energy generation share target
// - hydro hourly min/max limits and monthly energy budgets

// ============================================================================
// DATA BLOCKS
// ============================================================================

data demand_data source="../bad-scaling/data/Load_hourly_2025.csv" {
  map t from="*Hour"
  set t
  param demand from="Load" {
    index t
  }
}

data nuclear_data source="../bad-scaling/data/Nucl_hourly_2025.csv" {
  map t from="*Hour"
  param nuclear_mw from="Nuclear" {
    index t
  }
}

data hydro_budget_reference_data source="../bad-scaling/data/lahy_hourly_2025.csv" {
  map t from="*Hour"
  param hydro_budget_reference_mw from="LargeHydro" {
    index t
  }
}

data hydro_min_data source="../bad-scaling/data/lahy_min_hourly_2025.csv" {
  map t from="*Hour"
  param hydro_min_mw from="LargeHydro" {
    index t
  }
}

data hydro_max_data source="../bad-scaling/data/lahy_max_hourly_2025.csv" {
  map t from="*Hour"
  param hydro_max_mw from="LargeHydro" {
    index t
  }
}

data other_renewables_data source="../bad-scaling/data/otre_hourly_2025.csv" {
  map t from="*Hour"
  param other_renewables_mw from="OtherRenewables" {
    index t
  }
}

data import_cap_data source="../bad-scaling/data/Import_Cap_2025.csv" {
  map t from="*Hour"
  param import_cap from="Imports" {
    index t
  }
}

data export_cap_data source="../bad-scaling/data/Export_Cap_2025.csv" {
  map t from="*Hour"
  param export_cap from="Exports" {
    index t
  }
}

data import_price_data source="../bad-scaling/data/import_prices_2025.csv" {
  map t from="*Hour"
  param import_price from="Imports_price" {
    index t
  }
}

data export_price_data source="../bad-scaling/data/export_prices_2025.csv" {
  map t from="*Hour"
  param export_price from="Exports_price" {
    index t
  }
}

data wind_plants_data source="data-bad-scaling/wind_plants.txt" {
  map wind_plant from="plant_id"

  set wind_plant alias="wp"
  param wind_max_capacity from="max_capacity" {
    index wind_plant
  }
  param wind_capex_m from="capex_m" {
    index wind_plant
  }
  param wind_fom_m from="fom_m" {
    index wind_plant
  }
  param wind_trans_cost from="trans_cap_cost" {
    index wind_plant
  }
}

data solar_plants_data source="data-bad-scaling/solar_plants.txt" {
  map solar_plant from="plant_id"

  set solar_plant alias="sp"
  param solar_max_capacity from="max_capacity" {
    index solar_plant
  }
  param solar_capex_m from="capex_m" {
    index solar_plant
  }
  param solar_fom_m from="fom_m" {
    index solar_plant
  }
  param solar_trans_cost from="trans_cap_cost" {
    index solar_plant
  }
}

data wind_cf_data source="../bad-scaling/data/CFWind_2025.csv" {
  map t from="Hour"

  param wind_cf from="Nordeste" {
    index t
  }
}

data solar_cf_data source="../bad-scaling/data/CFSolar_2025.csv" {
  map t from="Hour"

  param solar_cf from="Nordeste" {
    index t
  }
}

data storage_data source="data-bad-scaling/storage.txt" {
  map storage_tech from="tech_id"

  set storage_tech alias="j"
  param p_capex {
    index storage_tech
  }
  param e_capex {
    index storage_tech
  }
  param efficiency {
    index storage_tech
  }
  param min_duration {
    index storage_tech
  }
  param max_duration {
    index storage_tech
  }
  param max_p {
    index storage_tech
  }
  param max_cycles {
    index storage_tech
  }
  param coupled {
    index storage_tech
  }
  param storage_fom from="fom" {
    index storage_tech
  }
  param storage_vom from="vom" {
    index storage_tech
  }
  param storage_lifetime from="lifetime" {
    index storage_tech
  }
  param cost_ratio {
    index storage_tech
  }
}

data thermal_data source="../bad-scaling/data/Data_BalancingUnits_2025.csv" {
  map thermal_unit from="Plant_id"

  set thermal_unit alias="bu"
  param min_capacity from="MinCapacity" {
    index thermal_unit
  }
  param max_capacity from="MaxCapacity" {
    index thermal_unit
  }
  param thermal_lifetime from="Lifetime" {
    index thermal_unit
  }
  param thermal_capex from="Capex" {
    index thermal_unit
  }
  param heat_rate from="HeatRate" {
    index thermal_unit
  }
  param fuel_cost from="FuelCost" {
    index thermal_unit
  }
  param thermal_vom from="VOM" {
    index thermal_unit
  }
  param thermal_fom from="FOM" {
    index thermal_unit
  }
}

data scalars_data source="../bad-scaling/data/scalars.csv" {
  map scalar_name from="Parameter"

  set scalar_name alias="sn"
  param scalar_value from="Value" {
    index scalar_name
  }
}

data hydro_budget_sets source="../bad-scaling/data/Load_hourly_2025.csv" {
  map t from="*Hour"

  set hydro_budget_month_1 {
    in t
    filter { t <= 730 }
  }
  set hydro_budget_month_2 {
    in t
    filter { t > 730 and t <= 1460 }
  }
  set hydro_budget_month_3 {
    in t
    filter { t > 1460 and t <= 2190 }
  }
  set hydro_budget_month_4 {
    in t
    filter { t > 2190 and t <= 2920 }
  }
  set hydro_budget_month_5 {
    in t
    filter { t > 2920 and t <= 3650 }
  }
  set hydro_budget_month_6 {
    in t
    filter { t > 3650 and t <= 4380 }
  }
  set hydro_budget_month_7 {
    in t
    filter { t > 4380 and t <= 5110 }
  }
  set hydro_budget_month_8 {
    in t
    filter { t > 5110 and t <= 5840 }
  }
  set hydro_budget_month_9 {
    in t
    filter { t > 5840 and t <= 6570 }
  }
  set hydro_budget_month_10 {
    in t
    filter { t > 6570 and t <= 7300 }
  }
  set hydro_budget_month_11 {
    in t
    filter { t > 7300 and t <= 8030 }
  }
  set hydro_budget_month_12 {
    in t
    filter { t > 8030 and t <= 8760 }
  }
}

// ============================================================================
// MODEL
// ============================================================================

model sdom_bad_scaling {
  set time alias="t"

  param mw_to_kw 1000
  param big_m 200000
  param epsilon 0.0001

  param demand {
    index time
  }
  param nuclear_mw {
    index time
  }
  param hydro_budget_reference_mw {
    index time
  }
  param hydro_min_mw {
    index time
  }
  param hydro_max_mw {
    index time
  }
  param other_renewables_mw {
    index time
  }
  param import_cap {
    index time
  }
  param export_cap {
    index time
  }
  param import_price {
    index time
  }
  param export_price {
    index time
  }

  // --- Wind plant parameters ---
  param wind_max_capacity {
    index wind_plant
  }
  param wind_capex_m {
    index wind_plant
  }
  param wind_fom_m {
    index wind_plant
  }
  param wind_trans_cost {
    index wind_plant
  }
  param wind_cf {
    index time
  }

  // --- Solar plant parameters ---
  param solar_max_capacity {
    index solar_plant
  }
  param solar_capex_m {
    index solar_plant
  }
  param solar_fom_m {
    index solar_plant
  }
  param solar_trans_cost {
    index solar_plant
  }
  param solar_cf {
    index time
  }

  // --- Storage parameters ---
  param p_capex {
    index storage_tech
  }
  param e_capex {
    index storage_tech
  }
  param efficiency {
    index storage_tech
  }
  param min_duration {
    index storage_tech
  }
  param max_duration {
    index storage_tech
  }
  param max_p {
    index storage_tech
  }
  param max_cycles {
    index storage_tech
  }
  param coupled {
    index storage_tech
  }
  param storage_fom {
    index storage_tech
  }
  param storage_vom {
    index storage_tech
  }
  param storage_lifetime {
    index storage_tech
  }
  param cost_ratio {
    index storage_tech
  }

  // --- Thermal parameters ---
  param min_capacity {
    index thermal_unit
  }
  param max_capacity {
    index thermal_unit
  }
  param thermal_lifetime {
    index thermal_unit
  }
  param thermal_capex {
    index thermal_unit
  }
  param heat_rate {
    index thermal_unit
  }
  param fuel_cost {
    index thermal_unit
  }
  param thermal_vom {
    index thermal_unit
  }
  param thermal_fom {
    index thermal_unit
  }

  // --- Scalar parameters loaded as key/value table ---
  param scalar_value {
    index scalar_name
  }

  expression discount_rate {
    scalar_value["r"]
  }

  expression vre_lifetime {
    scalar_value["LifeTimeVRE"]
  }

  expression alpha_nuclear {
    scalar_value["AlphaNuclear"]
  }

  expression alpha_hydro {
    scalar_value["AlphaLargeHy"]
  }

  expression alpha_other_renewables {
    scalar_value["AlphaOtherRe"]
  }

  expression gen_mix_target {
    scalar_value["GenMix_Target"]
  }

  expression crf_vre {
    (discount_rate * pow(1 + discount_rate, vre_lifetime)) / (pow(1 + discount_rate, vre_lifetime) - 1)
  }

  expression max_export_cap {
    14500
  }

  // ========================================================================
  // DECISION VARIABLES (controls)
  // ========================================================================

  control wind_cap_frac lower=0 upper=1 {
    index wind_plant
  }
  control solar_cap_frac lower=0 upper=1 {
    index solar_plant
  }

  control wind_gen lower=0 {
    index time
  }
  control wind_curtail lower=0 {
    index time
  }
  control solar_gen lower=0 {
    index time
  }
  control solar_curtail lower=0 {
    index time
  }

  control pc lower=0 {
    index time
    index storage_tech
  }
  control pd lower=0 {
    index time
    index storage_tech
  }
  control soc lower=0 {
    index time
    index storage_tech
  }

  control pcha lower=0 {
    index storage_tech
  }
  control pdis lower=0 {
    index storage_tech
  }
  control ecap lower=0 {
    index storage_tech
  }

  control storage_binary kind=binary {
    index storage_tech
    index time
  }

  control thermal_cap lower=0 {
    index thermal_unit
  }
  control thermal_gen lower=0 {
    index time
    index thermal_unit
  }

  control hydro_gen lower=0 {
    index time
  }

  control imports lower=0 {
    index time
  }

  control exports lower=0 {
    index time
  }

  control net_load_positive kind=binary {
    index time
  }

  // ========================================================================
  // COST EXPRESSIONS
  // ========================================================================

  expression wind_capex {
    crf_vre * sum((wind_capex_m[wp] * mw_to_kw + wind_trans_cost[wp]) * wind_max_capacity[wp] * wind_cap_frac[wp] for wp in wind_plant)
  }

  expression solar_capex {
    crf_vre * sum((solar_capex_m[sp] * mw_to_kw + solar_trans_cost[sp]) * solar_max_capacity[sp] * solar_cap_frac[sp] for sp in solar_plant)
  }

  expression wind_fom {
    sum(wind_fom_m[wp] * mw_to_kw * wind_max_capacity[wp] * wind_cap_frac[wp] for wp in wind_plant)
  }

  expression solar_fom {
    sum(solar_fom_m[sp] * mw_to_kw * solar_max_capacity[sp] * solar_cap_frac[sp] for sp in solar_plant)
  }

  expression storage_power_capex {
    sum(
      (
        (discount_rate * pow(1 + discount_rate, storage_lifetime[j]))
        /
        (pow(1 + discount_rate, storage_lifetime[j]) - 1)
      )
      *
      (
        mw_to_kw * cost_ratio[j] * p_capex[j] * pcha[j]
        + mw_to_kw * (1 - cost_ratio[j]) * p_capex[j] * pdis[j]
      )
      for j in storage_tech
    )
  }

  expression storage_energy_capex {
    sum(
      (
        (discount_rate * pow(1 + discount_rate, storage_lifetime[j]))
        /
        (pow(1 + discount_rate, storage_lifetime[j]) - 1)
      )
      * mw_to_kw * e_capex[j] * ecap[j]
      for j in storage_tech
    )
  }

  expression storage_fixed_om {
    sum(mw_to_kw * cost_ratio[j] * storage_fom[j] * pcha[j] + mw_to_kw * (1 - cost_ratio[j]) * storage_fom[j] * pdis[j] for j in storage_tech)
  }

  expression storage_var_om {
    sum(storage_vom[j] * sum(pd[t,j] for t in time) for j in storage_tech)
  }

  expression thermal_total_capex {
    sum(
      (
        (discount_rate * pow(1 + discount_rate, thermal_lifetime[bu]))
        /
        (pow(1 + discount_rate, thermal_lifetime[bu]) - 1)
      )
      * thermal_capex[bu] * mw_to_kw * thermal_cap[bu]
      for bu in thermal_unit
    )
  }

  expression thermal_total_fom {
    sum(thermal_fom[bu] * mw_to_kw * thermal_cap[bu] for bu in thermal_unit)
  }

  expression thermal_fuel_cost {
    sum(fuel_cost[bu] * heat_rate[bu] * sum(thermal_gen[t,bu] for t in time) for bu in thermal_unit)
  }

  expression thermal_var_om {
    sum(thermal_vom[bu] * sum(thermal_gen[t,bu] for t in time) for bu in thermal_unit)
  }

  expression trade_cost {
    sum(import_price[t] * imports[t] - export_price[t] * exports[t] for t in time)
  }

  expression total_vre_cost {
    wind_capex + solar_capex + wind_fom + solar_fom
  }

  expression total_storage_cost {
    storage_power_capex + storage_energy_capex + storage_fixed_om + storage_var_om
  }

  expression total_thermal_cost {
    thermal_total_capex + thermal_total_fom + thermal_fuel_cost + thermal_var_om
  }

  // ========================================================================
  // CONSTRAINTS
  // ========================================================================

  constraint supply_balance {
    index t { in time }
    expression {
      demand[t]
      + sum(pc[t,j] for j in storage_tech)
      + exports[t]
      - sum(pd[t,j] for j in storage_tech)
      - alpha_nuclear * nuclear_mw[t]
      - hydro_gen[t]
      - alpha_other_renewables * other_renewables_mw[t]
      - solar_gen[t]
      - wind_gen[t]
      - sum(thermal_gen[t,bu] for bu in thermal_unit)
      - imports[t]
      = 0
    }
  }

  constraint gen_mix_share {
    expression {
      sum(thermal_gen[t,bu] for t in time for bu in thermal_unit)
      <= (1 - gen_mix_target)
      * sum(demand[t] + sum(pc[t,j] for j in storage_tech) - sum(pd[t,j] for j in storage_tech) for t in time)
    }
  }

  constraint wind_balance {
    index t { in time }
    expression {
      wind_gen[t] + wind_curtail[t]
      = wind_cf[t] * sum(wind_max_capacity[wp] * wind_cap_frac[wp] for wp in wind_plant)
    }
  }

  constraint solar_balance {
    index t { in time }
    expression {
      solar_gen[t] + solar_curtail[t]
      = solar_cf[t] * sum(solar_max_capacity[sp] * solar_cap_frac[sp] for sp in solar_plant)
    }
  }

  // Cyclical SOC: t=1 wraps to the last time step
  constraint soc_balance_initial {
    index j { in storage_tech }
    expression {
      soc[1,j] = soc[8760,j]
        + sqrt(efficiency[j]) * pc[1,j]
        - pd[1,j] / sqrt(efficiency[j])
    }
  }

  constraint soc_balance {
    index j { in storage_tech }
    index t { in time }
    if { t > 1 }
    expression {
      soc[t,j] = soc[t-1,j]
        + sqrt(efficiency[j]) * pc[t,j]
        - pd[t,j] / sqrt(efficiency[j])
    }
  }

  constraint charge_binary_limit {
    index t { in time }
    index j { in storage_tech }
    expression {
      pc[t,j] <= max_p[j] * storage_binary[j,t]
    }
  }

  constraint discharge_binary_limit {
    index t { in time }
    index j { in storage_tech }
    expression {
      pd[t,j] <= max_p[j] * (1 - storage_binary[j,t])
    }
  }

  constraint max_hourly_charging {
    index t { in time }
    index j { in storage_tech }
    expression {
      pc[t,j] <= pcha[j]
    }
  }

  constraint max_hourly_discharging {
    index t { in time }
    index j { in storage_tech }
    expression {
      pd[t,j] <= pdis[j]
    }
  }

  constraint max_soc {
    index t { in time }
    index j { in storage_tech }
    expression {
      soc[t,j] <= ecap[j]
    }
  }

  constraint max_charge_capacity {
    index j { in storage_tech }
    expression {
      pcha[j] <= max_p[j]
    }
  }

  constraint max_discharge_capacity {
    index j { in storage_tech }
    expression {
      pdis[j] <= max_p[j]
    }
  }

  // Coupled technologies (Li-Ion, PHS) must have equal charge/discharge capacity
  constraint charge_equals_discharge {
    index j { in storage_tech }
    if { coupled[j] > 0 }
    expression {
      pcha[j] = pdis[j]
    }
  }

  constraint min_energy_capacity {
    index j { in storage_tech }
    expression {
      ecap[j] >= min_duration[j] * pdis[j] / sqrt(efficiency[j])
    }
  }

  constraint max_energy_capacity {
    index j { in storage_tech }
    expression {
      ecap[j] <= max_duration[j] * pdis[j] / sqrt(efficiency[j])
    }
  }

  constraint max_cycle_year {
    index j { in storage_tech }
    expression {
      sum(pd[t,j] for t in time) <= (max_cycles[j] / storage_lifetime[j]) * ecap[j]
    }
  }

  constraint thermal_min_capacity {
    index bu { in thermal_unit }
    expression {
      thermal_cap[bu] >= min_capacity[bu]
    }
  }

  constraint thermal_max_capacity {
    index bu { in thermal_unit }
    expression {
      thermal_cap[bu] <= max_capacity[bu]
    }
  }

  constraint thermal_capacity_limit {
    index t { in time }
    index bu { in thermal_unit }
    expression {
      thermal_cap[bu] >= thermal_gen[t,bu]
    }
  }

  constraint hydro_min_limit {
    index t { in time }
    expression {
      alpha_hydro * hydro_min_mw[t] <= hydro_gen[t]
    }
  }

  constraint hydro_max_limit {
    index t { in time }
    expression {
      hydro_gen[t] <= alpha_hydro * hydro_max_mw[t]
    }
  }

  constraint hydro_budget_month_1 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_1) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_1)
    }
  }

  constraint hydro_budget_month_2 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_2) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_2)
    }
  }

  constraint hydro_budget_month_3 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_3) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_3)
    }
  }

  constraint hydro_budget_month_4 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_4) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_4)
    }
  }

  constraint hydro_budget_month_5 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_5) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_5)
    }
  }

  constraint hydro_budget_month_6 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_6) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_6)
    }
  }

  constraint hydro_budget_month_7 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_7) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_7)
    }
  }

  constraint hydro_budget_month_8 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_8) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_8)
    }
  }

  constraint hydro_budget_month_9 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_9) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_9)
    }
  }

  constraint hydro_budget_month_10 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_10) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_10)
    }
  }

  constraint hydro_budget_month_11 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_11) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_11)
    }
  }

  constraint hydro_budget_month_12 {
    expression {
      sum(hydro_gen[t] for t in hydro_budget_month_12) = sum(hydro_budget_reference_mw[t] for t in hydro_budget_month_12)
    }
  }

  constraint import_capacity_limit {
    index t { in time }
    expression {
      imports[t] <= import_cap[t]
    }
  }

  constraint export_capacity_limit {
    index t { in time }
    expression {
      exports[t] <= export_cap[t]
    }
  }

  constraint net_load_upper_indicator {
    index t { in time }
    expression {
      demand[t]
      - (wind_gen[t] + wind_curtail[t])
      - (solar_gen[t] + solar_curtail[t])
      - alpha_nuclear * nuclear_mw[t]
      - alpha_other_renewables * other_renewables_mw[t]
      - hydro_gen[t]
      <= big_m * net_load_positive[t]
    }
  }

  constraint net_load_lower_indicator {
    index t { in time }
    expression {
      -(demand[t]
      - (wind_gen[t] + wind_curtail[t])
      - (solar_gen[t] + solar_curtail[t])
      - alpha_nuclear * nuclear_mw[t]
      - alpha_other_renewables * other_renewables_mw[t]
      - hydro_gen[t])
      + epsilon
      <= big_m * (1 - net_load_positive[t])
    }
  }

  constraint import_only_positive_net_load {
    index t { in time }
    expression {
      imports[t] <= demand[t] * net_load_positive[t]
    }
  }

  constraint export_only_negative_net_load {
    index t { in time }
    expression {
      exports[t] <= max_export_cap * (1 - net_load_positive[t])
    }
  }

  minimize total_cost {
    total_vre_cost + total_storage_cost + total_thermal_cost + trade_cost
  }
}

scenario sdom_bad_scaling_8760h {
  use sdom_bad_scaling
  report total_cost
