
set "time" { "1" }

data "defaults" source="data/top.csv" {
  map "time" from="time"
  param "capacity" index="time" from="cap"
}

model "Dispatch" {
  set time alias="t"

  param "capacity" {
    index "t"
  }

  control "x" {
    index "t"
  }

  constraint "cap_limit[t]" {
    x[t] <= capacity[t]
  }

  minimize "Obj" {
    sum(x[t] for t in time)
  }
}

scenario "S1" {
  use "Dispatch"
  data "capacity" source="data/override.csv"
}
