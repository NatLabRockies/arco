
set "area" { "a1" }
set "tech" { "solar" }
set "gen" { "g1" }
set "bus" { "b1" }

set "feasible_links" {
  index "a" { in "area" }
  index "i" { in "tech" }
  index "g" { in "gen" }
  index "b" { in "bus" }
}

projection "ai" {
  from "feasible_links"
  to "a" "z"
}

model "Dispatch" {
  minimize "Obj" { 0 }
}

scenario "S1" {
  use "Dispatch"
}
