
model "Dispatch" {
  param "demand" {
    index "t"
  }
  control "x" {
    index "a"
    index "t"
  }
  constraint "bal[a,t]" {
    x[a,t] <= demand[t]
  }
  minimize "Obj" {
    sum(x[a,t] for a in assets for t in time)
  }
}

scenario "S1" {
  use "Dispatch"
  data "unknown_param" source="data.csv"
}
