
set "time" { "1" }

data "distance" source="data/dist.csv" {
  set "g"
  set "b"
  param "distance_km" {
    index "g"
    index "b"
  }
}

model "SparseDistance" {
  set "g"
  set "b"

  param "distance_km" {
    index "g"
    index "b"
  }

  control "flow" lower=0 {
    index "g"
    index "b"
  }

  minimize "TotalCost" {
    sum(distance_km[g,b] * flow[g,b] for g in g for b in b)
  }
}

scenario "SparseDistanceCase" {
  use "SparseDistance"
}
