
set "a" { "n1" }

model "Dispatch" {
  control "x" {
    index "i" { in "a" }
  }

  constraint "bal" {
    index "i" { in "a" }
    expression { x[i] <= 1 }
  }

  constraint "bal" {
    index "i" { in "a" }
    expression { x[i] >= 0 }
  }

  minimize "Obj" { sum(x[i] for i in a) }
}

scenario "S1" {
  use "Dispatch"
}
