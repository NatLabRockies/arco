
set "area" { "1"; "2" }
set "tech" { "wind"; "solar" }

set "feasible_links" {
  index "a" { in "area" }
  index "i" { in "tech" }
}

set "target_pairs" {
  in "feasible_links"
  index "a" { in "tech" }
}

model "Dispatch" {
  control "x" {
    index "a" { in "feasible_links" }
    index "i" { in "feasible_links" }
  }

  minimize "Obj" { 0 }
}

scenario "S1" {
  use "Dispatch"
}
