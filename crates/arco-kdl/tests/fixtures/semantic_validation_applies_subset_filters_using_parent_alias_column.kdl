
data "assets_data" source="data/assets.csv" {
  map "asset_id" from="asset_name"

  set "asset_id" alias="a"
  set "north_assets" {
    in "a"
    filter { zone == "north" }
  }
}

model "Dispatch" {
  set "asset_id" alias="a"

  control "x" {
    index "a"
  }

  minimize "Obj" {
    sum(x[a] for a in asset_id)
  }
}

scenario "S1" {
  use "Dispatch"
}
