
data "links" source="data/links.csv" {
  alias "generators" column="gen"
  alias "buses" column="bus"

  set "area"
  set "tech"
  set "generators"
  set "buses"

  set "feasible_links" {
    index "a" { in "area" }
    index "i" { in "tech" }
    index "g" { in "generators" }
    index "b" { in "buses" }
    filter { feasible > 0 }
  }
}

set "feasible_links" {
  index "a" { in "area" }
  index "i" { in "tech" }
  index "g" { in "generators" }
  index "b" { in "buses" }
  filter { a == "1" }
}

model "TupleDispatch" {
  control "x" lower=0 {
    index "a" { in "feasible_links" }
    index "i" { in "feasible_links" }
    index "g" { in "feasible_links" }
    index "b" { in "feasible_links" }
  }

  minimize "Obj" { 0 }
}

scenario "S1" {
  use "TupleDispatch"
}
