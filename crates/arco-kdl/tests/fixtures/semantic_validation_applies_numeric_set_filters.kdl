
data "assets_data" source="data/assets.csv" {
  set "asset_id" alias="a"
  set "candidate_assets" {
    in "asset_id"
    filter { is_candidate > 0 }
  }
}

model "Dispatch" {
  set "asset_id" alias="a"

  control "x" {
    index "a"
  }

  minimize "Obj" {
    sum(x[a] for a in asset_id)
  }
}

scenario "S1" {
  use "Dispatch"
}
