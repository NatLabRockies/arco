// Predicates/keywords should share one color
set gen alias=g
set time alias=t {
  member 1
  member 2
  member 3
}

data generators source="data/generators.csv" {
  map gen from=generator
  alias zone column=balancing_area
  param capacity_mw index=gen
  param fuel_cost from=cost_per_mwh index=gen

  set thermal {
    in gen
    filter { type == thermal }
  }
}

projection area_gen {
  from { "generator_area" }
  to { "area"; "gen" }
}

model dispatch_model {
  var dispatch lower=0 {
    index gen
    index time
  }

  constraint cap_limit {
    index g { in gen }
    index t { in time }
    expression { dispatch[g,t] <= capacity_mw[g] }
  }

  constraint balance {
    sum(dispatch[g,t] for g in gen) = demand[t]
  }

  minimize total_cost {
    sum(fuel_cost[g] * dispatch[g,t] for g in gen for t in time)
  }
}

scenario demo {
  use dispatch_model
}
