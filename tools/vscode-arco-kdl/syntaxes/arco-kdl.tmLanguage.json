{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arco KDL",
  "scopeName": "source.arco-kdl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.arco-kdl", "match": "//.*$" },
        { "name": "comment.block.arco-kdl", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.arco-kdl", "begin": "\\\"\\\"\\\"", "end": "\\\"\\\"\\\"" },
        { "name": "string.quoted.double.arco-kdl", "begin": "\\\"", "end": "\\\"", "patterns": [{ "name": "constant.character.escape.arco-kdl", "match": "\\\\." }] }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.arco-kdl", "match": "\\b-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.arco-kdl", "match": "\\b(?:data|map|alias|set|param|model|control|var|constraint|expression|expr|minimize|maximize|scenario|use|use_data|report|index|in|filter|if|bounds|lower|upper|reduce|projection|from|to|sum|avg|min|max|first|last)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arco-kdl", "match": "==|!=|<=|>=|=>|[=+\\-*/<>]" }
      ]
    }
  }
}
