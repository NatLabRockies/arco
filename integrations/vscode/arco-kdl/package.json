{
  "name": "arco-kdl-vscode",
  "displayName": "arco KDL",
  "description": "VS Code support for arco KDL validation, formatting, and syntax highlighting.",
  "version": "0.1.0",
  "private": true,
  "publisher": "natlabrockies",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/NatLabRockies/arco.git",
    "directory": "integrations/vscode/arco-kdl"
  },
  "files": [
    "extension.js",
    "language-configuration.json",
    "README.md",
    "LICENSE.txt",
    "scripts/install-local.js",
    "syntaxes/arco-kdl.tmLanguage.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:arco-kdl",
    "onCommand:arcoKdl.validateCurrentFile",
    "onCommand:arcoKdl.formatCurrentFile",
    "onCommand:arcoKdl.selectCheckCommand",
    "onCommand:arcoKdl.showSetup"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arco-kdl",
        "aliases": [
          "arco KDL",
          "arco-kdl"
        ],
        "extensions": [
          ".kdl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arco-kdl",
        "scopeName": "source.arco-kdl",
        "path": "./syntaxes/arco-kdl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "arcoKdl.validateCurrentFile",
        "title": "arco KDL: Validate Current File"
      },
      {
        "command": "arcoKdl.formatCurrentFile",
        "title": "arco KDL: Format Current File"
      },
      {
        "command": "arcoKdl.selectCheckCommand",
        "title": "arco KDL: Select arco CLI"
      },
      {
        "command": "arcoKdl.showSetup",
        "title": "arco KDL: Show Setup Help"
      }
    ],
    "configuration": {
      "title": "arco KDL",
      "properties": {
        "arco.kdl.checkCommand": {
          "type": "string",
          "default": "",
          "description": "Path to the arco CLI. Leave empty to auto-detect from ARCO_CLI, workspace target binaries, or PATH."
        },
        "arco.kdl.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate arco KDL files on save."
        },
        "arco.kdl.validateOnChange": {
          "type": "boolean",
          "default": false,
          "description": "Validate arco KDL files after edits."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "arcoKdl.validateCurrentFile",
          "when": "resourceLangId == arco-kdl",
          "group": "navigation@10"
        },
        {
          "command": "arcoKdl.formatCurrentFile",
          "when": "resourceLangId == arco-kdl",
          "group": "navigation@11"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check scripts/install-local.js && node --test test/*.test.js",
    "coverage": "npx --yes c8 --check-coverage --lines 95 --functions 95 --branches 95 --statements 95 node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "install:local": "npm run package && node scripts/install-local.js"
  }
}
