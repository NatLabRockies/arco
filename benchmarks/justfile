set shell := ["bash", "-cu"]

torc_db := "torc.db"
torc_pid := ".torc-server.pid"
torc_log := ".torc-server.log"

default:
    @just --list

bootstrap:
    uv sync --group dev
    just install-julia-deps

install-arco:
    uv add --upgrade arco

install-torc:
    tmpdir="$(mktemp -d)"; gh release download --repo NatLabRockies/torc --pattern "torc-x86_64-unknown-linux-musl.tar.gz" --dir "$tmpdir"; tar -xzf "$tmpdir/torc-x86_64-unknown-linux-musl.tar.gz" -C "$tmpdir"; mkdir -p "$HOME/.local/bin"; install -m 0755 "$tmpdir/torc" "$tmpdir/torc-server" "$HOME/.local/bin/"; rm -rf "$tmpdir"

install-julia-deps:
    bash scripts/run_jump_point.sh --install-only

start-torc:
    if [ -f {{torc_pid}} ] && kill -0 "$(cat {{torc_pid}})" >/dev/null 2>&1; then echo "torc-server already running"; exit 0; fi; nohup "$HOME/.local/bin/torc-server" run --database {{torc_db}} --host localhost --port 8080 --completion-check-interval-secs 2 > {{torc_log}} 2>&1 & echo $! > {{torc_pid}}; sleep 1

stop-torc:
    if [ -f {{torc_pid}} ]; then kill "$(cat {{torc_pid}})" >/dev/null 2>&1 || true; rm -f {{torc_pid}}; fi

run-benchmark:
    "$HOME/.local/bin/torc" run workflows/benchmark.yaml --poll-interval 2

export-results:
    PATH="$HOME/.local/bin:$PATH" uv run python scripts/export_results.py --out results/benchmark_points.csv

export-results-id workflow_id:
    PATH="$HOME/.local/bin:$PATH" uv run python scripts/export_results.py --workflow-id {{workflow_id}} --out results/benchmark_points.csv

plot:
    uv run python scripts/plot_results.py --input results/benchmark_points.csv --out-dir plots

smoke:
    just start-torc
    just run-benchmark
    just export-results
    just plot
